{
  "name": "checklist-lojas", "version": "1.0.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @checklist/api\" \"npm run dev -w @checklist/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "start": "docker compose up --build"
  },
  "devDependencies": {"concurrently": "^9.2.1", "@playwright/test": "^1.56.1", "typescript": "^5.9.3"}
}
